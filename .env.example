# Copy this file to .env and fill it in. .env is git-ignored: keys never go into the repository.
GEMINI_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
KAGGLE_API_TOKEN=
ANTHROPIC_API_KEY=
# Only when that key is not scoped to one workspace: the workspace to use (Console, Workspaces, an id like wrkspc_...).
ANTHROPIC_WORKSPACE_ID=
# Optional. Seconds to wait after every model call. Raise it (for example 5) if a free tier answers HTTP 429.
HERITAGE_PAUSE_S=0

