# Copy this file to .env and fill it in. .env is git-ignored: keys never go into the repository.

# Speech and the checks. A key from Google AI Studio.
GEMINI_API_KEY=

# Pictures. From the Cloudflare dashboard: the account id, and a token with Workers AI permission.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional. Runs the GPU jobs from the command line (python -m pipeline kaggle run music).
# From https://www.kaggle.com/settings/api, "Generate New Token". The account needs a verified phone number.
KAGGLE_API_TOKEN=

# Optional. Only when `models.judge` in storyboard.json names a claude- model. A key with credit from platform.claude.com.
ANTHROPIC_API_KEY=

# Optional. Seconds to wait after every model call, on top of the per-minute limits in pricing.json.
HERITAGE_PAUSE_S=0
