# secrets
.env
kaggle.json

# python
__pycache__/
*.pyc
.venv/

# offline test runs: never evidence, never committed
outputs_mock/
site_mock/

# the public page is built from the repository by `make site` and published by a workflow
site/

# scratch inside real outputs
outputs/tmp/
outputs/assemble/work/
outputs/*/ingest_tmp/
tmp-*

# keep the answer key of a blind test out of sight until the votes are in
outputs/blindtest/*/key.json

# re-renders that FFmpeg rebuilds from the files that ARE kept (no model call needed)
outputs/assemble/*.mp4
outputs/assemble/*.wav
outputs/shots/*_kenburns__*.mp4
outputs/keyframes/*_card__*.png
outputs/keyframes/*_c[0-9]__*.png
outputs/keyframes/ref_*__*.png
outputs/music/placeholder__*.wav
outputs/*/kaggle_job/
outputs/*/kaggle_job.zip
outputs/*/kaggle_upload/
outputs/*/kaggle_kernel/
outputs/*/kaggle_output/
.dev
# local settings of the coding agent
.claude/
plan.md
# the two test mixes of E12: rebuilt by `python experiments/e12_ducking.py`, 15 MB each
outputs/experiments/E12/*.wav

# The cut is not committed while it is a rough cut: a push publishes it on the public page.
# Remove these five lines for the release commit, when the lines are confirmed and the films are final.
outputs/film_*.mp4
outputs/radio_cut.mp4
outputs/qc_report.json
outputs/assemble/
